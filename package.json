{
  "name": "una-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Chat Socket.IO UNA con soporte de imagenes/videos y validacion anti-XSS",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:local": "node --env-file=.env server.js",
    "test": "mocha",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "spec:validate": "openspec validate --all --strict",
    "security:audit": "npm audit --omit=dev",
    "security:snyk": "snyk test",
    "security:snyk-code": "snyk code test",
    "security:monitor": "snyk monitor",
    "check": "npm run spec:validate && npm run security:audit && npm test && npm run test:integration"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "^11.10.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.2",
    "@playwright/test": "^1.64.1",
    "chai": "^6.3.0",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "snyk": "^1.1308.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e/",
      "<rootDir>/test/"
    ]
  }
}
