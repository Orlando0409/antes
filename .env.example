# Copiar a .env (ignorado por git) y completar SOLO en el equipo local.
# Render no define OTEL_*: sin endpoint no se exporta nada a Grafana Cloud.

# Grafana Cloud > Connections > OpenTelemetry (OTLP): gateway terminado en /otlp
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 de instanceId:token glc_...>, sin comillas
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=

# Sentry: solo en las variables de entorno de Render
SENTRY_DSN=

# Login con Auth0. Sin AUTH0_DOMAIN o AUTH0_CLIENT_ID el chat queda abierto (pruebas).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Local: http://localhost:3000. Render: URL publica HTTPS, sin barra final.
APP_BASE_URL=

# Postgres del rol una_chat_backend. TLS obligatorio.
# Host directo (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler (IPv4): postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# No definir AUTH0_CLIENT_SECRET: el servidor lee una_chat_auth0_client_secret de Supabase Vault al arrancar.
